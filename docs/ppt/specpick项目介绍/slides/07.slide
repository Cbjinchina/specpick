<Slide style={{ width: 1280, height: 720, background: '#F5F6F3', padding: 60 }}>
  <Box style={{ flex: 1, justifyContent: 'center', gap: 26 }}>
    <Text style={{ fontSize: 19, color: '#6C736A', lineHeight: 1.5 }}>关于显卡跑分</Text>
    <Text style={{ fontSize: 104, fontWeight: 'bold', color: '#176B4D', lineHeight: 1.05 }}>我不知道</Text>
    <Box style={{ width: 92, height: 4, background: '#86D3AC', borderRadius: 2, marginTop: 6 }} />
    <Text style={{ fontSize: 20, color: '#1B1E1A', lineHeight: 1.7, marginTop: 10 }}>跑分没有唯一答案：不同测试、不同驱动，<br />同一张卡能差 20% 以上。</Text>
    <Text style={{ fontSize: 20, color: '#6C736A', lineHeight: 1.7 }}>抓一个数字回来，看起来科学，<br />其实是我替你选了一个你没同意过的标准。</Text>
  </Box>

  <Box style={{ borderTop: '1px solid #DFE3DB', paddingTop: 26 }}>
    <Text style={{ fontSize: 26, fontWeight: 'bold', color: '#1B1E1A', lineHeight: 1.4 }}>宁可承认不知道，也不假装精确</Text>
  </Box>
</Slide>
